# ============ 必填 ============
# 管理员密码(dashboard 登录),务必使用强密码
ADMIN_PASSWORD=change-me-to-a-strong-password

# ============ Nginx 反向代理 ============
# Docker 仅将服务绑定至 127.0.0.1:${APP_PORT:-8000},由宿主机 Nginx 转发。
# APP_PORT=8000

# ============ 可选(默认值适用于大多数场景) ============
# SQLite 数据目录(Docker 内已固定为 /data,本地运行可自定义)
# DATA_DIR=./data
# SESSION_SECRET=            # 留空则自动生成并持久化到 DATA_DIR
# KEYPOOL_COOLDOWN_SECONDS=60    # 429 后该 key 的冷却秒数
# KEYPOOL_MAX_RETRIES=4          # 单次调用的最大换 key 重试次数
# USAGE_SYNC_INTERVAL_HOURS=6    # 每 6 小时校准一次各 key 的真实配额
# LOG_RETENTION_DAYS=30          # 请求日志保留天数
# DEFAULT_TOKEN_RPM=30           # 新建 token 的默认每分钟限额
# CHARACTER_LIMIT=25000          # 工具输出截断字符数
# COOKIE_SECURE=1                # 生产环境保持 1;纯 http 本地调试可设 0
